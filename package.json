{
  "name": "sonora-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server": "powershell -ExecutionPolicy Bypass -File scripts/run_server.ps1",
    "mobile": "npm run start --prefix apps/mobile",
    "test:server": "powershell -ExecutionPolicy Bypass -File scripts/test_server.ps1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.7.2"
  }
}
